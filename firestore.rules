rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Colección de Vehículos (Catálogo público de la concesionaria)
    match /cars/{carId} {
      allow read, write: if true;
    }

    // Colección de Facturas (Emisión, consulta y gestión de facturas)
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Colección de Usuarios y Perfiles de clientes
    match /users/{userId} {
      allow read, write: if true;
    }

    // Colección de Órdenes y Reservas VIP
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}
